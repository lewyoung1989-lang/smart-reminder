DJANGO_SECRET_KEY=replace-for-local-use
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
POSTGRES_DB=smart_reminder
POSTGRES_USER=smart_reminder
POSTGRES_PASSWORD=local-development
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MINIO_ROOT_USER=smart-reminder
MINIO_ROOT_PASSWORD=local-development-only
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=8
OCR_PROVIDER=rapidocr
OCR_LANGUAGE=ch
OCR_TEXT_SCORE=0.50
OCR_MAX_IMAGE_BYTES=8388608
OCR_MAX_IMAGE_SIDE=2048
OCR_JOB_RETENTION_HOURS=24
OCR_WORKER_CONCURRENCY=1
OCR_TASK_SOFT_TIME_LIMIT=45
OCR_TASK_TIME_LIMIT=60
OCR_MAX_RETRIES=2
OCR_MODEL_ROOT=
OCR_QUEUE=ocr
OCR_STORAGE_PROVIDER=s3
OCR_UPLOAD_URL_TTL_SECONDS=600
S3_INTERNAL_ENDPOINT=http://minio:9000
# iPhone 真机测试时改为 Mac 局域网地址，例如 http://192.168.1.10:9000。
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=smart-reminder-private
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=smart-reminder
S3_SECRET_ACCESS_KEY=local-development-only
