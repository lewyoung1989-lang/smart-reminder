flowchart TB
  subgraph Client["Flutter App"]
    UI["首页 / 提醒 / 药箱 / 家庭"]
    Voice["麦克风 / 短音频转写 / 草稿确认"]
    Local["Drift / 离线队列 / 本地规则"]
    Bridge["原生能力适配器"]
    UI --> Voice
    UI --> Local
    Local --> Bridge
  end

  subgraph OS["手机系统能力"]
    AlarmKit["iOS 26+ AlarmKit"]
    LocalNotification["旧版 iOS 本地通知降级"]
    AndroidAlarm["第二阶段 Android AlarmManager"]
  end

  subgraph API["Django API"]
    Auth["认证 / 家庭权限"]
    Reminder["提醒规则 / 条件引擎"]
    Medicine["药品 / 批次 / 服药"]
    OCR["OCR 编排"]
    VoiceAPI["语音上传 / 转写"]
    Draft["提醒草稿 / 确认"]
    Parser["确定性时间解析 / 实体解析"]
    Validator["Pydantic + JSON Schema"]
    Admin["Django Admin"]
    Worker["Celery Worker / Beat"]
  end

  subgraph Runtime["腾讯云 Lighthouse / Docker Compose"]
    Edge["Nginx\naipupu.cloud / files.aipupu.cloud"]
    PG[("PostgreSQL")]
    Redis[("Redis")]
    Object[("私有 MinIO\n24 小时临时图片")]
    Image["本机 Docker 镜像"]
    Compute["Lighthouse 4核4GB"]
    Observe["CLS / 腾讯云监控"]
    Secret["CAM / KMS"]
    ASR["自建 FunASR 服务"]
  end

  subgraph Provider["外部 Provider 适配层"]
    LLM["DeepSeek 官方 API / 百炼"]
    OCRProvider["RapidOCR / 可选阿里云 OCR"]
    Weather["和风天气"]
    Push["APNs / 移动推送"]
    Holiday["法定节假日数据"]
  end

  Bridge --> AlarmKit
  Bridge --> LocalNotification
  Bridge --> AndroidAlarm
  UI --> Auth
  UI --> Reminder
  UI --> Medicine
  UI --> OCR
  UI -->|"HTTPS 签名 PUT"| Edge
  Edge --> Object
  Voice --> VoiceAPI
  VoiceAPI --> ASR
  VoiceAPI --> Draft
  Draft --> Parser
  Parser --> LLM
  Parser --> Validator
  Validator --> Reminder
  Auth --> PG
  Reminder --> PG
  Medicine --> PG
  Draft --> Redis
  OCR --> Object
  OCR --> Worker
  Reminder --> Worker
  Worker --> Redis
  Worker --> Weather
  Worker --> Push
  Worker --> OCRProvider
  Worker --> Holiday
  Image --> Compute
