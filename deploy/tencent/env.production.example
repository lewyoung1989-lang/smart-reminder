# Tencent Cloud production environment template. Never commit real values.
DOMAIN=aipupu.cloud
FILES_DOMAIN=files.aipupu.cloud
APP_VERSION=
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=aipupu.cloud
DJANGO_CSRF_TRUSTED_ORIGINS=https://aipupu.cloud
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
LOG_LEVEL=INFO
POSTGRES_DB=smart_reminder
POSTGRES_USER=smart_reminder
POSTGRES_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
AUTH_CACHE_URL=redis://redis:6379/4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=8
ASR_PROVIDER=funasr
ASR_BASE_URL=http://funasr:8000
ASR_LEASE_PROVIDER=redis
ASR_MODEL=paraformer-zh
ASR_TIMEOUT_SECONDS=75
ASR_MAX_AUDIO_BYTES=4194304
ASR_MAX_REQUEST_BYTES=5242880
ASR_MIN_DURATION_SECONDS=0.3
ASR_MAX_DURATION_SECONDS=60
ASR_GLOBAL_CONCURRENCY=1
ASR_CONCURRENCY_PER_USER=1
ASR_LEASE_TTL_SECONDS=90
ASR_USER_RATE=10/min
ASR_IP_RATE=30/min
ASR_REDIS_URL=redis://redis:6379/0
ASR_THROTTLE_REDIS_URL=redis://redis:6379/2
ASR_TRUSTED_PROXY_IPS=172.29.0.10
OCR_ENABLED=false
OCR_PROVIDER=rapidocr
OCR_STORAGE_PROVIDER=s3
OCR_JOB_RETENTION_HOURS=24
OCR_QUEUE=ocr
OCR_SEMANTIC_PROVIDER=deepseek
OCR_SEMANTIC_TIMEOUT_SECONDS=8
OCR_DEBUG_TEXT_LOGGING=false
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://files.aipupu.cloud
S3_BUCKET=smart-reminder-private
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CERTBOT_EMAIL=
BACKUP_DIR=/opt/smart-reminder/backups/postgres
BACKUP_RETENTION_DAYS=14
